{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|site.webmanifest|favicon|.*\\.js$|.*\\.css$|.*\\.png$|.*\\.svg$|.*\\.ico$|.*\\.woff2?$).*)",
      "destination": "/index.html"
    }
  ]
}
